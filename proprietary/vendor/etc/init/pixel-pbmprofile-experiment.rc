# This experiment allows dynamically controlling the PowerBudgetManager profile
# at run time from server configuration through Mendel.
#
# It monitors the phenotype flag: `vendor.pixel.system.phenotype.Thermal__pbm_profile`
# and sets the system property: `vendor.powerhal.budgetmanager.profile`.
#
# It requires `vendor.thermal.allow_experiments` to be enabled.
# On change, it restarts the PowerHAL AIDL service to apply the new profile.
# It supports switching between 'Static' and 'None' profiles even if the
# experiment is already running.
#
# Set up or update the experiment.

on property:vendor.thermal.allow_experiments=1 \
    && property:vendor.pixel.system.phenotype.Thermal__pbm_profile=Static \
    && property:vendor.thermal.pbmprofile_experiment_is_running=""
    setprop vendor.thermal.pbmprofile_experiment_is_running 1
    setprop vendor.powerhal.budgetmanager.profile Static
    restart vendor.power-hal-aidl

# Update profile to Static if it was None.
on property:vendor.thermal.allow_experiments=1 \
    && property:vendor.pixel.system.phenotype.Thermal__pbm_profile=Static \
    && property:vendor.powerhal.budgetmanager.profile=None
    setprop vendor.thermal.pbmprofile_experiment_is_running 1
    setprop vendor.powerhal.budgetmanager.profile Static
    restart vendor.power-hal-aidl

on property:vendor.thermal.allow_experiments=1 \
    && property:vendor.pixel.system.phenotype.Thermal__pbm_profile=None \
    && property:vendor.thermal.pbmprofile_experiment_is_running=""
    setprop vendor.thermal.pbmprofile_experiment_is_running 1
    setprop vendor.powerhal.budgetmanager.profile None
    restart vendor.power-hal-aidl

# Update profile to None if it was Static.
on property:vendor.thermal.allow_experiments=1 \
    && property:vendor.pixel.system.phenotype.Thermal__pbm_profile=None \
    && property:vendor.powerhal.budgetmanager.profile=Static
    setprop vendor.thermal.pbmprofile_experiment_is_running 1
    setprop vendor.powerhal.budgetmanager.profile None
    restart vendor.power-hal-aidl

# Ramp down the experiment, but only if it was running before.
on property:vendor.thermal.allow_experiments=1 \
    && property:vendor.thermal.pbmprofile_experiment_is_running=1 \
    && property:vendor.pixel.system.phenotype.Thermal__pbm_profile=""
    setprop vendor.thermal.pbmprofile_experiment_is_running ""
    setprop vendor.powerhal.budgetmanager.profile ""
    restart vendor.power-hal-aidl

# Handle disabling experiments globally
on property:vendor.thermal.allow_experiments=0 \
    && property:vendor.thermal.pbmprofile_experiment_is_running=1
    setprop vendor.thermal.pbmprofile_experiment_is_running ""
    setprop vendor.powerhal.budgetmanager.profile ""
    restart vendor.power-hal-aidl
